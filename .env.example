# Copy to .env (gitignored). Never commit real values.
# Meta developer API key (https://dev.meta.ai/docs/authentication) — used for all paid Meta calls.
META_DEV_API=
# ElevenLabs Scribe v2 key; empty disables the independent dialogue ASR vote.
ELEVENLABS_API_KEY=
# API bearer token used by the web UI, CLI and executor (generate: openssl rand -hex 24).
PROOFFRAME_API_TOKEN=
# Only for the public Traefik deployment (docker-compose.deploy.yml): htpasswd -nbB user password, single-quoted.
PROOFFRAME_BASIC_AUTH_USERS=''
# Spend caps, run mode and other settings are in docker-compose.yml.
