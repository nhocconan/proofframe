# Configuration blueprint for the application to be implemented.
# The contract seed does not make API calls or load this file.
PROOFFRAME_MODE=meta_hackathon
PROOFFRAME_ALLOW_PAID_CALLS=false
# Set explicit nonzero caps only after checking current provider pricing.
PROOFFRAME_MAX_RUN_COST_USD=0
PROOFFRAME_MAX_PROJECT_COST_USD=0
PROOFFRAME_MAX_REPAIR_ATTEMPTS=2
META_API_KEY=
# Resolve actual endpoint and model IDs from official docs/capability probes.
META_BASE_URL=
META_REASONING_MODEL=
META_VIDEO_MODEL=
META_TRACKING_MODEL=
META_TRANSCRIPTION_MODEL=
