{
  "$defs": {
    "AssetBinding": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Asset Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "video",
            "audio",
            "image",
            "document",
            "composition"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        }
      },
      "required": [
        "asset_id",
        "revision",
        "sha256",
        "media_type"
      ],
      "title": "AssetBinding",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Assertion Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evaluator_version": {
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        }
      },
      "required": [
        "assertion_id",
        "status",
        "rationale",
        "evaluator_version"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Sha256",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "metadata",
            "frame",
            "clip",
            "audio",
            "scan",
            "reference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "inspection": {
          "enum": [
            "artifact",
            "sampled",
            "exhaustive"
          ],
          "title": "Inspection",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "extractor_version": {
          "minLength": 1,
          "title": "Extractor Version",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Trace Id",
          "type": "string"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        }
      },
      "required": [
        "evidence_id",
        "asset_id",
        "asset_sha256",
        "artifact_sha256",
        "kind",
        "inspection",
        "uri",
        "extractor_version",
        "trace_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN",
        "NOT_CHECKED",
        "ERROR",
        "NOT_APPLICABLE"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "proofframe.report.v0.1",
      "default": "proofframe.report.v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "run_mode": {
      "enum": [
        "synthetic_fixture",
        "live",
        "recorded_replay"
      ],
      "title": "Run Mode",
      "type": "string"
    },
    "contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Sha256",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetBinding"
      },
      "title": "Assets",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "run_mode",
    "contract_sha256",
    "assets",
    "evidence",
    "results"
  ],
  "title": "VerificationReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
